# ── Bee & Cairn core ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
N8N_MATURATION_WEBHOOK=https://hermihook.app.n8n.cloud/webhook/bee-and-cairn-maturation


# ── Rippily traffic webhook (/api/rippily-webhook) ──────────────────────────
# The signing secret shown in Wave > Settings > Webhooks. Required: without it
# the endpoint returns 503 rather than recording traffic it cannot trust.
RIPPILY_WEBHOOK_SECRET=

# Where verified join/leave events are forwarded. An n8n webhook is the natural
# home, since the Maturation Log already runs there. Leave empty to log only.
RIPPILY_TRAFFIC_WEBHOOK=

# Set to true for the first Send Test Event only, so an unverified delivery is
# accepted and its headers logged. Remove it once the signature scheme is pinned.
# RIPPILY_ALLOW_UNSIGNED=true

# Pin the signature scheme after the first verified delivery. The values come
# from the rippily.webhook.detected log line. Pinning stops the receiver from
# trying alternatives on every request.
# RIPPILY_SIGNATURE_HEADER=x-rippily-signature
# RIPPILY_SIGNATURE_ENCODING=hex
# RIPPILY_SIGNATURE_SCHEME=body


# ── Rippily signups (/api/rippily-signup) ───────────────────────────────────
# Member Links from Wave > People > Members > Generate Member Link.
# The default link, used when no channel matches.
RIPPILY_MEMBER_LINK=

# Optional per-channel links. Generate one link per channel in Rippily and its
# own usage count becomes your attribution, with no extra tracking needed.
# RIPPILY_MEMBER_LINKS={"newsletter":"<link copied from Rippily>","companion":"<link copied from Rippily>"}

# Where website signups are filed before the traveller is handed to Rippily.
RIPPILY_SIGNUP_WEBHOOK=


# ── Shared ──────────────────────────────────────────────────────────────────
# Comma separated origins allowed to call the signup endpoint. Empty means open,
# matching the current /api/chat.js policy.
# RIPPILY_ALLOWED_ORIGINS=https://yoursite.com,https://www.yoursite.com
